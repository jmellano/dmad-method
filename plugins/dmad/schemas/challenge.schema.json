{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dmad.dev/schemas/challenge.schema.json",
  "title": "DMAD Challenge",
  "description": "Le résultat d'une attaque du Challenger sur une claim. Les 9 angles doivent tous être examinés ; un angle non exploré est une faiblesse déclarée du run.",
  "type": "object",
  "required": [
    "id",
    "claim",
    "angles_examined",
    "outcome",
    "challenged_at",
    "type"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^CHK-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"
    },
    "claim": {
      "type": "string"
    },
    "challenged_at": {
      "type": "string",
      "format": "date-time"
    },
    "angles_examined": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9
      },
      "uniqueItems": true,
      "description": "1 preuve trahie | 2 garde oubliée | 3 flag/config | 4 polymorphisme | 5 chemin d'erreur | 6 transaction | 7 exhaustivité | 8 code mort | 9 concurrence"
    },
    "angles_skipped": {
      "type": "array",
      "description": "Un angle non examiné doit être justifié (ex: pas de concurrence possible sur un batch mono-thread).",
      "items": {
        "type": "object",
        "required": [
          "angle",
          "reason"
        ],
        "properties": {
          "angle": {
            "type": "integer"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "angle",
          "severity",
          "finding",
          "evidence",
          "consequence"
        ],
        "properties": {
          "angle": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9
          },
          "severity": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "finding": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "consequence": {
            "type": "string",
            "description": "Ce que ça change pour le lecteur, pas seulement pour la claim."
          }
        }
      }
    },
    "weakest_claims": {
      "type": "array",
      "description": "Quota de doute : si aucun finding sur une capacité entière, le Challenger DOIT produire les 3 claims les plus fragiles avec l'argument de fragilité. Zéro finding sur 40 claims signale un Challenger complaisant.",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "fragility"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "fragility": {
            "type": "string"
          }
        }
      }
    },
    "outcome": {
      "enum": [
        "confirmed",
        "demoted",
        "contradicted",
        "split",
        "reformulate"
      ]
    },
    "from": {
      "enum": [
        "V",
        "C",
        "I",
        "H"
      ]
    },
    "to": {
      "enum": [
        "V",
        "C",
        "I",
        "H"
      ]
    },
    "required_action": {
      "type": "string"
    },
    "opened_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time",
      "description": "Quand la contradiction a été levée. Une contradiction non résolue BLOQUE la production de la SFG : laissée en SFD elle devient une promesse fausse faite à l'utilisateur, et son lecteur n'a aucun moyen de la détecter."
    },
    "resolved_by": {
      "type": "string",
      "description": "Qui a tranché. Une résolution anonyme ne se rejoue pas."
    },
    "resolution": {
      "type": "string",
      "description": "Comment. Le plus souvent, la résolution n'est pas « l'une des deux est fausse » mais « il manquait la distinction entre deux temps du traitement » — et c'est cette distinction qui est l'information."
    },
    "type": {
      "type": "string",
      "minLength": 2,
      "description": "Nature du concept. Requise par OKF — c'est sa seule règle dure."
    },
    "title": {
      "type": "string",
      "description": "Nom d'affichage du concept (OKF §4.1)."
    },
    "description": {
      "type": "string",
      "description": "Une phrase. Reprise telle quelle par les index."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "demoted"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "from",
          "to",
          "findings"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "contradicted"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "findings"
        ]
      }
    }
  ]
}
