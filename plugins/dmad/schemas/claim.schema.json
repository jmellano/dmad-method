{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dmad.dev/schemas/claim.schema.json",
  "title": "DMAD Claim",
  "description": "Une affirmation produite par DMAD. Aucune affirmation ne peut être publiée sans respecter ce schéma : c'est le point d'application mécanique du principe P2 (aucune affirmation sans preuve).",
  "type": "object",
  "required": ["id", "type", "statement", "confidence", "confidence_reason", "evidence", "produced_by", "freshness"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(BR|UC|INV|CAP|ST|ACT|TERM|RISK)-[A-Z0-9]+-[0-9]{3}$",
      "description": "Identifiant stable. Préfixe = type. Ex: BR-FACT-014"
    },
    "type": {
      "enum": ["BusinessRule", "UseCase", "Invariant", "Capability", "StateMachine", "Actor", "Term", "Risk"]
    },
    "capability": { "type": "string" },
    "statement": {
      "type": "string",
      "minLength": 10,
      "description": "Ce que le système FAIT. Prouvable. Ne doit jamais contenir de pourquoi — celui-ci va dans intent."
    },
    "confidence": {
      "enum": ["V", "C", "I", "H"],
      "description": "V vérifié | C corroboré | I inféré | H hypothèse"
    },
    "confidence_reason": {
      "type": "string",
      "minLength": 20,
      "description": "Pourquoi ce niveau et pas le suivant. Champ obligatoire : il force l'agent à expliciter ce qui manque pour monter."
    },
    "confidence_ceiling_applied": {
      "enum": ["V", "C", "I", "H"],
      "description": "Plafond imposé par une capability dégradée, s'il y a lieu."
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "description": "Au moins une preuve. Une claim sans preuve est refusée à l'écriture.",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "intent": { "$ref": "#/$defs/intent" },
    "relates_to": {
      "type": "array",
      "items": { "type": "string" }
    },
    "contradicts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "challenged_by": {
      "type": "array",
      "items": { "type": "string", "pattern": "^CHK-" }
    },
    "challenge_outcome": {
      "enum": ["confirmed", "demoted", "contradicted", "split", "reformulate", "pending"]
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string", "pattern": "^OQ-[0-9]{3}$" }
    },
    "produced_by": {
      "type": "string",
      "description": "id de l'agent producteur"
    },
    "promoted_by": {
      "type": "string",
      "description": "Uniquement test-forger, et uniquement sur test vert."
    },
    "conditional_on": {
      "type": "object",
      "description": "Une règle dont le comportement dépend d'un flag ou d'une configuration N'EST PAS une règle inconditionnelle. Ce bloc rend la condition explicite au lieu de la laisser implicite.",
      "required": ["kind", "key", "default", "observed"],
      "properties": {
        "kind": { "enum": ["feature_flag", "env_config", "database_param", "build_profile"] },
        "key": { "type": "string" },
        "default": { "type": "string" },
        "observed": {
          "type": "object",
          "description": "Valeur constatée par environnement",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "freshness": { "$ref": "#/$defs/freshness" },
    "status": {
      "enum": ["draft", "challenged", "validated", "retired"],
      "default": "draft"
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["kind", "ref"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["code", "test", "schema", "migration", "commit", "ticket", "runtime", "config", "absence"],
          "description": "'absence' documente une preuve négative (ex: aucun test associé). C'est une information, pas un vide."
        },
        "ref": {
          "type": "string",
          "description": "fichier#Ldébut-Lfin, sha de commit, nom de table, identifiant de ticket."
        },
        "commit": { "type": "string" },
        "tool": {
          "type": "string",
          "description": "Outil ayant produit la preuve. OBLIGATOIRE pour toute arête mécanique du graphe — c'est l'invariant vérifiable du Cartographer."
        },
        "outcome": { "enum": ["passing", "failing", "skipped", "not_run"] },
        "excerpt": { "type": "string", "maxLength": 500 },
        "note": { "type": "string" }
      }
    },
    "intent": {
      "type": "object",
      "description": "Le POURQUOI. Séparé du statement parce qu'il n'est jamais prouvable par le code (principe P5).",
      "required": ["statement", "confidence"],
      "additionalProperties": false,
      "properties": {
        "statement": { "type": "string" },
        "confidence": {
          "enum": ["H", "C"],
          "description": "H par défaut et sans exception. Ne peut passer à C que par validated_by."
        },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "competing_hypotheses": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Lectures concurrentes quand l'histoire est ambiguë. Exposer plutôt que choisir la plus élégante."
        },
        "validated_by": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["who", "when"],
              "properties": {
                "who": { "type": "string" },
                "when": { "type": "string", "format": "date-time" },
                "note": { "type": "string" }
              }
            }
          ]
        },
        "question": { "type": "string" }
      }
    },
    "freshness": {
      "type": "object",
      "required": ["verified_at_commit", "status"],
      "additionalProperties": false,
      "properties": {
        "verified_at_commit": { "type": "string" },
        "verified_at": { "type": "string", "format": "date-time" },
        "status": { "enum": ["fresh", "shifted", "stale", "broken"] },
        "last_checked": { "type": "string", "format": "date-time" }
      }
    }
  }
}
