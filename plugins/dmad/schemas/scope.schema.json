{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dmad.dev/schemas/scope.schema.json",
  "title": "DMAD Scope",
  "description": "Cadrage d'un run. Produit par le Scoper, validé au gate 0. Rien ne démarre sans ce fichier.",
  "type": "object",
  "required": ["run_id", "objective", "mode", "perimeter", "budget", "sources", "confidentiality"],
  "additionalProperties": false,
  "properties": {
    "run_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "objective": {
      "type": "object",
      "required": ["statement", "kind"],
      "description": "La réponse à : dans trois semaines, que devez-vous pouvoir faire que vous ne pouvez pas faire aujourd'hui ?",
      "properties": {
        "statement": { "type": "string", "minLength": 20 },
        "kind": {
          "enum": ["evolve", "maintain", "decide_refactor", "audit", "onboard", "migrate"],
          "description": "Oriente la priorisation de tout le run."
        }
      }
    },
    "mode": { "enum": ["full-scan", "feature-scan"] },
    "perimeter": {
      "type": "object",
      "required": ["repositories", "include", "exclude"],
      "properties": {
        "repositories": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "include": { "type": "array", "items": { "type": "string" } },
        "exclude": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "reason"],
            "properties": {
              "path": { "type": "string" },
              "reason": { "type": "string", "description": "Une exclusion se justifie et s'écrit. Jamais implicite." }
            }
          }
        },
        "feature": {
          "type": "object",
          "description": "Obligatoire en mode feature-scan.",
          "required": ["label", "vocabulary"],
          "properties": {
            "label": { "type": "string" },
            "vocabulary": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 3,
              "description": "Vocabulaire métier d'amorce. Levier principal de la localisation."
            },
            "known_entrypoints": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "required": ["max_traversal_depth"],
      "properties": {
        "max_tokens": { "type": "integer" },
        "max_wall_clock_minutes": { "type": "integer" },
        "max_traversal_depth": { "type": "integer", "default": 5 },
        "max_diagrams_per_capability": { "type": "integer", "default": 8 },
        "characterization_tests_target": { "type": "integer" }
      }
    },
    "sources": {
      "type": "object",
      "required": ["git_history"],
      "properties": {
        "git_history": { "enum": ["full", "truncated", "none"] },
        "issue_tracker": { "type": ["string", "null"] },
        "wiki": { "type": ["string", "null"] },
        "adr": { "type": ["string", "null"] },
        "runtime_evidence": {
          "type": "array",
          "items": { "enum": ["coverage", "traces", "logs", "none"] }
        },
        "humans": {
          "type": "array",
          "description": "Les experts encore joignables et leur domaine. Détermine ce qui pourra sortir de H.",
          "items": {
            "type": "object",
            "required": ["role", "domains"],
            "properties": {
              "role": { "type": "string" },
              "domains": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "capabilities_available": {
      "type": "object",
      "description": "Implémentations disponibles par capability. Détermine les plafonds de confiance du run.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "implementation": { "type": "string" },
          "confidence_ceiling": { "enum": ["V", "C", "I", "H"] },
          "status": { "enum": ["available", "degraded", "unavailable"] }
        }
      }
    },
    "confidentiality": {
      "type": "object",
      "required": ["level"],
      "description": "À trancher AVANT le premier appel d'outil.",
      "properties": {
        "level": { "enum": ["public", "internal", "confidential", "restricted"] },
        "local_only": { "type": "boolean", "default": false },
        "forbidden_egress": { "type": "array", "items": { "type": "string" } },
        "redaction_rules": { "type": "array", "items": { "type": "string" } }
      }
    },
    "gate_0": {
      "type": "object",
      "properties": {
        "approved_by": { "type": "string" },
        "approved_at": { "type": "string", "format": "date-time" },
        "notes": { "type": "string" }
      }
    }
  }
}
